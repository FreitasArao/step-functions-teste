{
  "Comment": "TODO (Prática): Definição da State Machine em ASL (Amazon States Language)",
  "StartAt": "ReserveStock",
  "States": {
    "ReserveStock": {
      "Type": "Task",
      "Comment": "TODO Passo 1: Enviar mensagem para a fila SQS (${queue_url}) aguardando callback (.waitForTaskToken) e configurar Catch para CancelOrder.",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${queue_url}",
        "MessageBody": {
          "stepName": "RESERVE_STOCK",
          "idempotencyKey.$": "States.Format('{}:RESERVE_STOCK', $.payload.orderId)",
          "taskToken.$": "$$.Task.Token",
          "metadata.$": "$.metadata",
          "payload.$": "$.payload"
        }
      },
      "ResultPath": "$.payload.stock",
      "End": true
    }
  }
}
