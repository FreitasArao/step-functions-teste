{
  "Comment": "Order Saga with 3 Forward Steps, 2-Level Cascading Rollback, SQS waitForTaskToken and MessageWrapper Distributed Tracing",
  "StartAt": "ReserveStock",
  "States": {
    "ReserveStock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${queue_url}",
        "MessageBody": {
          "stepName": "RESERVE_STOCK",
          "idempotencyKey.$": "States.Format('{}:RESERVE_STOCK', $.payload.orderId)",
          "taskToken.$": "$$.Task.Token",
          "metadata.$": "$.metadata",
          "payload.$": "$.payload"
        }
      },
      "ResultPath": "$.payload.stock",
      "Next": "ProcessPayment",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.payload.error",
          "Next": "CancelOrder"
        }
      ]
    },
    "ProcessPayment": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${queue_url}",
        "MessageBody": {
          "stepName": "PROCESS_PAYMENT",
          "idempotencyKey.$": "States.Format('{}:PROCESS_PAYMENT', $.payload.orderId)",
          "taskToken.$": "$$.Task.Token",
          "metadata.$": "$.metadata",
          "payload.$": "$.payload"
        }
      },
      "ResultPath": "$.payload.payment",
      "Next": "CreateShipment",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.payload.error",
          "Next": "ReleaseStock"
        }
      ]
    },
    "CreateShipment": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${queue_url}",
        "MessageBody": {
          "stepName": "CREATE_SHIPMENT",
          "idempotencyKey.$": "States.Format('{}:CREATE_SHIPMENT', $.payload.orderId)",
          "taskToken.$": "$$.Task.Token",
          "metadata.$": "$.metadata",
          "payload.$": "$.payload"
        }
      },
      "ResultPath": "$.payload.shipment",
      "Next": "ConfirmOrder",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.payload.error",
          "Next": "RefundPayment"
        }
      ]
    },
    "ConfirmOrder": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${queue_url}",
        "MessageBody": {
          "stepName": "CONFIRM_ORDER",
          "idempotencyKey.$": "States.Format('{}:CONFIRM_ORDER', $.payload.orderId)",
          "taskToken.$": "$$.Task.Token",
          "metadata.$": "$.metadata",
          "payload.$": "$.payload"
        }
      },
      "ResultPath": "$.payload.confirmation",
      "Next": "OrderConfirmed"
    },
    "RefundPayment": {
      "Type": "Task",
      "Comment": "Rollback Level 2: Refunds the approved payment and cascades into ReleaseStock",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${queue_url}",
        "MessageBody": {
          "stepName": "REFUND_PAYMENT",
          "idempotencyKey.$": "States.Format('{}:REFUND_PAYMENT', $.payload.orderId)",
          "taskToken.$": "$$.Task.Token",
          "metadata.$": "$.metadata",
          "payload.$": "$.payload"
        }
      },
      "ResultPath": "$.payload.paymentRefund",
      "Next": "ReleaseStock"
    },
    "ReleaseStock": {
      "Type": "Task",
      "Comment": "Rollback Level 1: Releases the reserved stock and cascades into CancelOrder",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${queue_url}",
        "MessageBody": {
          "stepName": "RELEASE_STOCK",
          "idempotencyKey.$": "States.Format('{}:RELEASE_STOCK', $.payload.orderId)",
          "taskToken.$": "$$.Task.Token",
          "metadata.$": "$.metadata",
          "payload.$": "$.payload"
        }
      },
      "ResultPath": "$.payload.stockRelease",
      "Next": "CancelOrder"
    },
    "CancelOrder": {
      "Type": "Task",
      "Comment": "Final Compensation Step: Marks order as CANCELLED with failure reason",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${queue_url}",
        "MessageBody": {
          "stepName": "CANCEL_ORDER",
          "idempotencyKey.$": "States.Format('{}:CANCEL_ORDER', $.payload.orderId)",
          "taskToken.$": "$$.Task.Token",
          "metadata.$": "$.metadata",
          "payload.$": "$.payload"
        }
      },
      "ResultPath": "$.payload.cancellation",
      "Next": "OrderCancelled"
    },
    "OrderConfirmed": {
      "Type": "Succeed"
    },
    "OrderCancelled": {
      "Type": "Fail",
      "Error": "ORDER_SAGA_ROLLED_BACK",
      "Cause": "Order saga failed and all compensations were executed."
    }
  }
}
